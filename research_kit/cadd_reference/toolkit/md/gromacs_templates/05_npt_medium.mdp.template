; 05_npt_medium - illustrative soluble-system profile, not engine-tested
define = -DPOSRES_SOLUTE -DPOSRES_FC=418.40
integrator = md
dt = 0.002
nsteps = 500000
continuation = yes
constraints = h-bonds
constraint-algorithm = lincs
lincs-order = 4
lincs-iter = 1
nstlist = 20
tcoupl = v-rescale
tc-grps = System
tau-t = 0.5
ref-t = 300
ld-seed = __SEED__
gen-vel = no
pcoupl = C-rescale
pcoupltype = isotropic
tau-p = 5.0
ref-p = 1.0
compressibility = 4.5e-5
refcoord-scaling = all
comm-mode = None
nstcalcenergy = 100
nstenergy = 500
nstlog = 500
nstxout = 0
nstvout = 0
nstfout = 0
nstxout-compressed = 1000
compressed-x-grps = System
cutoff-scheme = Verlet
verlet-buffer-tolerance = 0.005
coulombtype = PME
coulomb-modifier = None
rcoulomb = 1.0
vdwtype = Cut-off
vdw-modifier = None
rvdw = 1.0
DispCorr = EnerPres
fourierspacing = 0.12
pme-order = 4
ewald-rtol = 1e-5
pbc = xyz

