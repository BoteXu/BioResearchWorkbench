  ],
  "accounting": {
    "unit": "parent",
    "terminal_states_are_mutually_exclusive": true,
    "required_terminal_states": [
      "advance",
      "evaluated_not_selected",
      "qc_failed",
      "repair_pending",
      "budget_not_computed"
    ],
    "sum_of_terminal_states_must_equal_stage_input": true,
    "raw_task_failures_retained": true,
    "missing_scores_are_not_zero": true
  }
}
